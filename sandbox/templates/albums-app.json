{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources"
      }
    },
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Name for the Container Apps Environment"
      }
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Name for the Log Analytics Workspace"
      }
    },
    "appInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name for Application Insights"
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name for the Storage Account (used as Dapr state store)"
      }
    },
    "blobContainerName": {
      "type": "string",
      "defaultValue": "albums",
      "metadata": {
        "description": "Name for the blob container in the storage account"
      }
    },
    "containerRegistryName": {
      "type": "string",
      "metadata": {
        "description": "Name of the container registry (e.g., myregistry.azurecr.io without the .azurecr.io suffix)"
      }
    },
    "containerRegistryUsername": {
      "type": "string",
      "metadata": {
        "description": "Username for the container registry"
      }
    },
    "containerRegistryPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Password for the container registry"
      }
    },
    "albumApiImage": {
      "type": "string",
      "metadata": {
        "description": "Full image path for album API (e.g., myregistry.azurecr.io/album-api:latest)"
      }
    },
    "albumViewerImage": {
      "type": "string",
      "metadata": {
        "description": "Full image path for album viewer (e.g., myregistry.azurecr.io/album-viewer:latest)"
      }
    },
    "albumApiName": {
      "type": "string",
      "defaultValue": "album-api",
      "metadata": {
        "description": "Name for the album API container app"
      }
    },
    "albumViewerName": {
      "type": "string",
      "defaultValue": "album-viewer",
      "metadata": {
        "description": "Name for the album viewer container app"
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "app": "dapr-albums",
        "environment": "sandbox"
      },
      "metadata": {
        "description": "Tags to apply to all resources"
      }
    }
  },
  "variables": {
    "storageAccountNameClean": "[replace(parameters('storageAccountName'), '-', '')]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[parameters('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "retentionInDays": 30,
        "sku": {
          "name": "PerGB2018"
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appInsightsName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "web",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ],
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountNameClean')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('storageAccountNameClean'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountNameClean'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('storageAccountNameClean'), '/default/', parameters('blobContainerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountNameClean'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2023-05-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]",
        "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
      ],
      "properties": {
        "daprAIInstrumentationKey": "[reference(resourceId('Microsoft.Insights/components', parameters('appInsightsName'))).InstrumentationKey]",
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))).customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2022-10-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments/daprComponents",
      "apiVersion": "2023-05-01",
      "name": "[concat(parameters('environmentName'), '/statestore')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountNameClean'))]"
      ],
      "properties": {
        "componentType": "state.azure.blobstorage",
        "version": "v1",
        "ignoreErrors": false,
        "initTimeout": "5s",
        "secrets": [
          {
            "name": "storageaccountkey",
            "value": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountNameClean')), '2023-01-01').keys[0].value]"
          }
        ],
        "metadata": [
          {
            "name": "accountName",
            "value": "[variables('storageAccountNameClean')]"
          },
          {
            "name": "containerName",
            "value": "[parameters('blobContainerName')]"
          },
          {
            "name": "accountKey",
            "secretRef": "storageaccountkey"
          }
        ],
        "scopes": [
          "[parameters('albumApiName')]"
        ]
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[parameters('albumApiName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "secrets": [
            {
              "name": "registrypassword",
              "value": "[parameters('containerRegistryPassword')]"
            }
          ],
          "registries": [
            {
              "server": "[concat(parameters('containerRegistryName'), '.azurecr.io')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "registrypassword"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 80,
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "dapr": {
            "enabled": true,
            "appId": "[parameters('albumApiName')]",
            "appProtocol": "http",
            "appPort": 80
          }
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('albumApiName')]",
              "image": "[parameters('albumApiImage')]",
              "resources": {
                "cpu": "0.5",
                "memory": "1Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[parameters('albumViewerName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.App/containerApps', parameters('albumApiName'))]"
      ],
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "secrets": [
            {
              "name": "registrypassword",
              "value": "[parameters('containerRegistryPassword')]"
            }
          ],
          "registries": [
            {
              "server": "[concat(parameters('containerRegistryName'), '.azurecr.io')]",
              "username": "[parameters('containerRegistryUsername')]",
              "passwordSecretRef": "registrypassword"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "dapr": {
            "enabled": true,
            "appId": "[parameters('albumViewerName')]",
            "appProtocol": "http",
            "appPort": 3000
          }
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('albumViewerName')]",
              "image": "[parameters('albumViewerImage')]",
              "resources": {
                "cpu": "0.5",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "ALBUM_API_NAME",
                  "value": "[parameters('albumApiName')]"
                },
                {
                  "name": "DAPR_HTTP_PORT",
                  "value": "3500"
                },
                {
                  "name": "BACKGROUND_COLOR",
                  "value": "#007bff"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 5
          }
        }
      }
    }
  ],
  "outputs": {
    "environmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
    },
    "albumApiFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('albumApiName'))).configuration.ingress.fqdn]"
    },
    "albumViewerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('albumViewerName'))).configuration.ingress.fqdn]"
    },
    "albumViewerUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('albumViewerName'))).configuration.ingress.fqdn)]"
    }
  }
}
